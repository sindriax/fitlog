{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fitlog",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fitlog",
			"database_id": "4d51d6de-7d26-4ce1-838d-e0282dfcfdc0",
			"migrations_dir": "worker/migrations"
		}
	],
	"send_email": [{ "name": "EMAIL", "allowed_destination_addresses": ["owner@example.com"] }],
	"vars": {
		"ALLOWED_EMAILS": "owner@example.com",
		"EMAIL_FROM": "fitlog@sindriax.dev",
		"APP_URL": "https://fitlog.sindriax.dev"
	},
	"routes": [{ "pattern": "fitlog.sindriax.dev", "custom_domain": true }],
	"observability": { "enabled": true }
}
